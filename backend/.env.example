PORT=8000
DATABASE_URL=postgres://user:password@host:port/database?sslmode=require
JWT_SECRET=your_jwt_secret_key_change_this_to_a_long_random_string

# Set NODE_ENV=production to disable auto table sync and require strong JWT secrets
NODE_ENV=development

# SSL certificate verification for the database.
# Leave unset (or true) in production to verify the cert chain.
# Set to 'false' ONLY for local dev against a self-signed DB.
# DB_SSL_REJECT_UNAUTHORIZED=true

# Allowed browser origin for CORS (frontend URL)
CLIENT_URL=http://localhost:5173

# Google OAuth
GOOGLE_CLIENT_ID=your_clients_id_from_google_cloud_console
GOOGLE_CLIENT_SECRET=your_client_secret_from_google_cloud_console

# Jitsi JaaS (optional). The private key file is never committed to git.
JAAS_APP_ID=vpaas-magic-cookie-example
JAAS_API_KEY_ID=key_id_example
JAAS_PRIVATE_KEY_PATH=./jaas_private_key.pk

# SMTP (optional, e.g. Brevo)
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
