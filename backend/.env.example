PORT=8000
DATABASE_URL=postgres://user:password@host:port/database?sslmode=require
JWT_SECRET=your_jwt_secret_key_change_this_to_a_long_random_string

# Set NODE_ENV=production to disable auto table sync and require strong JWT secrets
NODE_ENV=development

# SSL certificate verification for the database.
# Leave unset (or true) in production to verify the cert chain.
# Set to 'false' ONLY for local dev against a self-signed DB.
# DB_SSL_REJECT_UNAUTHORIZED=true

# Allowed browser origin for CORS (frontend URL)
CLIENT_URL=http://localhost:5173

# Admin account - created/updated on server start. Log in with these on the login page.
ADMIN_EMAIL=admin@peersy.app
ADMIN_PASSWORD=change_this_to_a_strong_password

# Google OAuth
GOOGLE_CLIENT_ID=your_clients_id_from_google_cloud_console
GOOGLE_CLIENT_SECRET=your_client_secret_from_google_cloud_console

# LiveKit (REQUIRED for video sessions)
# Get these from https://cloud.livekit.io or a self-hosted LiveKit server
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
# In LiveKit project settings, add a webhook pointing to:
#   https://your-backend.example.com/api/livekit/webhook
# This lets the server track real session start/end times for accurate credit billing.

# Email (Resend) - get a key from https://resend.com
RESEND_API_KEY=your_resend_api_key
# The From address must be a verified domain/sender in Resend
MAIL_FROM=Peersy <onboarding@yourdomain.com>
